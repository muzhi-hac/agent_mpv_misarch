      "description": "Create a pending MiSArch order for a selected product variant. Controlled side effect: creates a shopping cart item and pending order only; does not place the order or trigger payment.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string",
            "description": "MiSArch user UUID owning the shopping cart and order"
          },
          "product_variant_id": {
            "type": "string",
            "description": "MiSArch product variant UUID selected by the agent"
          },
          "quantity": {
            "type": "integer",
            "description": "number of items to reserve in the pending order; allowed range 1 to 3"
          },
          "shipment_method_id": {
            "type": "string",
            "description": "MiSArch shipment method UUID to use for this order item"
          },
          "shipment_address_id": {
            "type": "string",
            "description": "MiSArch user address UUID where the order should be shipped"
          },
          "invoice_address_id": {
            "type": "string",
            "description": "MiSArch user address UUID used for invoicing"
          },
          "payment_information_id": {
            "type": "string",
            "description": "MiSArch payment information UUID; payment is not triggered by this tool"
          },
          "coupon_ids": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            },
            "description": "optional MiSArch coupon UUIDs to attach to the order item"
          }
        },
        "required": [
          "user_id",
          "product_variant_id",
          "quantity",
